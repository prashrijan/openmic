# Copy to .env.local for local dev. NEVER commit .env.local.
# All server-only vars must be set in Vercel for preview + production.

# --- Public (client + server) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never expose to browser) ---
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# 32-byte hex secret for signing guest cookies.
# Generate a fresh one with:  openssl rand -hex 32
GUEST_COOKIE_HMAC_SECRET=

# --- Optional (used in later tasks) ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
